{
  "imports": {
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2"
  },
  "tasks": {
    "test": "deno test --allow-net --allow-env --allow-read tests/",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "exclude": [".env.example"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  }
}
