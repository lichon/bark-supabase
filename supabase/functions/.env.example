# Bark push server — Edge Function configuration (contract: specs/001-bark-server-supabase/contracts/apns-push.md)
#
# Copy this file to supabase/functions/.env.local (gitignored) and fill in the values.
# Never commit a real value. `supabase secrets set --env-file ...` reads the same names.

# ---------------------------------------------------------------------------
# APNs provider credentials (all required)
# ---------------------------------------------------------------------------

# PKCS#8 PEM contents of the Apple provider key (.p8). Newlines may be literal
# or escaped as \n. Required.
APNS_P8=

# 10-character key identifier that belongs to the .p8 above. Required.
APNS_KEY_ID=

# 10-character Apple developer team identifier that owns the key. Required.
APNS_TEAM_ID=

# APNs topic (bundle id) used for `ios` devices. Required.
APNS_TOPIC_IOS=

# APNs topic (bundle id) used for `watchos` devices. Required.
APNS_TOPIC_WATCH=

# APNs host selector: `production` (default) or `sandbox`. Optional.
APNS_ENV=

# ---------------------------------------------------------------------------
# Optional behaviour
# ---------------------------------------------------------------------------

# Shared access credential. When set, every endpoint except `/`, `/ping` and
# `/healthz` requires `Authorization: Basic <base64(:token)>` or `Bearer <token>`.
# Optional; unset means open registration.
BARK_SERVER_TOKEN=

# Retention for `bark.delivery` rows, in days. Optional, default 30.
BARK_DELIVERY_RETENTION_DAYS=

# Reported by `GET /info`. Optional, default `dev`.
BARK_VERSION=

# Reported by `GET /info`. Optional, default empty.
BARK_COMMIT=

# Reported by `GET /info`. Optional, default `deno`.
BARK_BUILD=

# ---------------------------------------------------------------------------
# Platform-injected (do not set by hand on hosted Supabase)
# ---------------------------------------------------------------------------

# Project API URL, injected by the platform. Required.
SUPABASE_URL=

# Service-role key, injected by the platform. Required.
SUPABASE_SERVICE_ROLE_KEY=
